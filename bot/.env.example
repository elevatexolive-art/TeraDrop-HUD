# TeraDrop environment. Copy to .env and fill in real values.
# The web control center can view, edit, and add these without a manual reboot
# for live-apply keys. Restart-required keys are written immediately and take
# effect on the next process start (or via the Restart action).

# Telegram
BOT_TOKEN=
OWNER_IDS=
BOT_PUBLIC=true
AUTHORIZED_IDS=
FORCE_SUB_CHANNEL=
LOG_CHANNEL=
DUMP_CHANNEL=
BOT_NAME=TeraDrop
BOT_USERNAME=TeraDropBot
BOT_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Security
ADMIN_PANEL_PASSWORD=
SESSION_SECRET=

# Database
MONGODB_URI=
MONGODB_DATABASE=downloader_bot

# Limits
MAINTENANCE=false
MAX_FILE_MB=2000
MAX_CONCURRENT=8
MAX_QUEUE_SIZE=1000
FREE_LINKS_PER_24H=5
FREE_SEND_FILE_LIFETIME=5
AUTO_DELETE_MINUTES=45

# Copy
WELCOME_TEXT=
CAPTION_TEMPLATE={filename}\n{size}

# Resolvers
TERABOXDL_URL=https://www.teraboxdl.site
SOLVER_URL=
SOLVER_TIMEOUT=60
TURNSTILE_SITEKEY=
UPFILES_SOLVER_URL=
UPFILES_PLAYWRIGHT_TIMEOUT=90
UPFILES_TURNSTILE_SITEKEY=

# Mini Apps — endpoints below are auto-updated from live Mini App JS.
# Keep TG_BOT + WEBAPP_URL set; the rest is filled by auto-sync.
FLEZEN_TG_BOT=flezennbot
FLEZEN_WEBAPP_URL=https://flezen-downloader.pages.dev/
FLEZEN_API_DOWNLOAD=https://api2.diskwala.net/api/flezen/downloadw
FLEZEN_API_STATUS=https://api2.diskwala.net/api/flezen/statusw
FLEZEN_BOT_ID=flezen
FLEZEN_AES_KEY=
DISKWALA_TG_BOT=
DISKWALA_WEBAPP_URL=https://miniapp.diskwala.net/
DISKWALA_API_DOWNLOAD=https://api2.diskwala.net/api/diskwala/download1
DISKWALA_API_STATUS=https://api2.diskwala.net/api/diskwala/status1
DISKWALA_BOT_ID=diskwala
DISKWALA_AES_KEY=
VIDBUNKER_TG_BOT=vidbunkerbot
VIDBUNKER_WEBAPP_URL=https://vidbunker-ma.pages.dev/
VIDBUNKER_API_URL=https://vidbunker-backend.dailyweb577.workers.dev/api/download
VIDBUNKER_BOT_ID=vidbunker
MINIAPP_AUTO_SYNC=true
MINIAPP_SYNC_INTERVAL_MINUTES=15
MINIAPP_LAST_SYNC=
TELEGRAM_AUTH_REFRESH_MINUTES=40

# Payments
PAYTM_MID=
UPI_ID=
UPI_PAYEE_NAME=premium downloader
PAYMENT_API_URL=
PAYMENT_VERIFY_INTERVAL=60
PAYMENT_MAX_MINUTES=15
AMOUNT_TOLERANCE=0.01
PAYMENT_LOG_CHANNEL_ID=0

# Delivery
PUBLIC_BASE_URL=
PUBLIC_HOST=
PUBLIC_PORT=6969
DOWNLOAD_DIR=/app/data/tmp
DATA_DIR=/app/data
HEALTH_PORT=8080
