# Railway-only image for the Python bot. Not named "Dockerfile" so Vercel/Grok
# keep deploying the React HUD. railway.json points here.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DOWNLOAD_DIR=/app/data/tmp \
    DATA_DIR=/app/data \
    HEALTH_PORT=8080 \
    PORT=8080 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1001 teradrop \
    && mkdir -p /app/data/tmp \
    && chown -R teradrop:teradrop /app

COPY bot/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir playwright==1.48.0 \
    && playwright install chromium --with-deps \
    && chmod -R 777 "$PLAYWRIGHT_BROWSERS_PATH"

COPY bot/app /app/app

USER teradrop
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/' % os.environ.get('PORT','8080'), timeout=3)"

CMD ["python", "-m", "app"]
